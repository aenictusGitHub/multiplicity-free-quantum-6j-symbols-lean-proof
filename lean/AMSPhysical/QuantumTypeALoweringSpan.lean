import QuantumTypeAWordRaising
import QuantumTypeAGeneratorInvariant

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxHeartbeats 3600000
noncomputable section
namespace AMSPhysical
variable {V : Type*} [AddCommGroup V] [Module ℝ V]

def typeALoweringSpan (q : ℝ) (n : ℕ) (ρ : UqTypeA q n →ₐ[ℝ] Module.End ℝ V) (v : V) : Submodule ℝ V :=
  Submodule.span ℝ (Set.range (typeALoweredVector q n ρ v))

theorem typeALoweringSpan_F (q : ℝ) (n : ℕ) (ρ : UqTypeA q n →ₐ[ℝ] Module.End ℝ V) (v : V) (j : Fin n) :
    ρ (typeAAlgebraGenerator q n j 1)∈preservingEndAlgebra (typeALoweringSpan q n ρ v) := by
  apply span_preserving_of_family
  intro w
  rw [← typeALoweredVector_cons]
  exact Submodule.subset_span ⟨j::w,rfl⟩

theorem typeALoweringSpan_invariant (q : ℝ) (hq : q≠0) (n : ℕ)
    (ρ : UqTypeA q n →ₐ[ℝ] Module.End ℝ V) (v : V) (lam : Fin n → ℤ)
    (hvE : ∀ i,ρ (typeAAlgebraGenerator q n i 0) v=0)
    (hvK : ∀ i,ρ (typeAAlgebraGenerator q n i 2) v=q^(lam i) • v) :
    algebraInvariant ρ (typeALoweringSpan q n ρ v) := by
  apply typeAInvariant_of_generators q n ρ
  intro i t
  fin_cases t
  · change ρ (typeAAlgebraGenerator q n i 0)∈preservingEndAlgebra (typeALoweringSpan q n ρ v)
    apply span_preserving_of_family
    intro w
    induction w with
    | nil => simpa only [typeALoweredVector_nil,hvE] using (typeALoweringSpan q n ρ v).zero_mem
    | cons j w ih =>
      rw [typeALoweredVector_E_cons q hq n ρ v lam hvK i j w]
      exact (typeALoweringSpan q n ρ v).add_mem
        (typeALoweringSpan_F q n ρ v j _ ih)
        ((typeALoweringSpan q n ρ v).smul_mem _ (Submodule.subset_span ⟨w,rfl⟩))
  · exact typeALoweringSpan_F q n ρ v i
  · change ρ (typeAAlgebraGenerator q n i 2)∈preservingEndAlgebra (typeALoweringSpan q n ρ v)
    apply span_preserving_of_family
    intro w
    rw [typeALoweredVector_K q hq n ρ v lam hvK w i]
    exact (typeALoweringSpan q n ρ v).smul_mem _ (Submodule.subset_span ⟨w,rfl⟩)
  · change ρ (typeAAlgebraGenerator q n i 3)∈preservingEndAlgebra (typeALoweringSpan q n ρ v)
    apply span_preserving_of_family
    intro w
    rw [typeALoweredVector_Ki q hq n ρ v lam hvK w i]
    exact (typeALoweringSpan q n ρ v).smul_mem _ (Submodule.subset_span ⟨w,rfl⟩)

/-- The entire actual highest cyclic module is generated by lowering words.
No PBW basis or triangular-decomposition theorem is assumed. -/
theorem typeALoweringSpan_eq_cyclic (q : ℝ) (hq : q≠0) (n : ℕ)
    (ρ : UqTypeA q n →ₐ[ℝ] Module.End ℝ V) (v : V) (lam : Fin n → ℤ)
    (hvE : ∀ i,ρ (typeAAlgebraGenerator q n i 0) v=0)
    (hvK : ∀ i,ρ (typeAAlgebraGenerator q n i 2) v=q^(lam i) • v) :
    typeALoweringSpan q n ρ v=algebraCyclicSpan ρ v := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro x ⟨w,rfl⟩
    exact Submodule.subset_span ⟨typeALoweringWord q n w,rfl⟩
  · apply algebraCyclicSpan_minimal ρ v _ (typeALoweringSpan_invariant q hq n ρ v lam hvE hvK)
    have hm : typeALoweredVector q n ρ v []∈typeALoweringSpan q n ρ v := Submodule.subset_span ⟨[],rfl⟩
    simpa only [typeALoweredVector_nil] using hm

end AMSPhysical
#print axioms AMSPhysical.typeALoweringSpan_eq_cyclic
